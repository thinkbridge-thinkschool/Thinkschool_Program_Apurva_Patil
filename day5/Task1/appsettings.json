{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Day3": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db"
  },

  "Jwt": {
    "SigningKey": "dev-signing-key-change-in-production-min32chars!!",
    "Issuer": "your-app",
    "Audience": "your-audience",
    "AccessTokenLifetime": "00:15:00"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "29483a98-f908-4076-94c2-a30a84723e0d",
    "ClientId": "2eb613d3-e36b-4a18-8838-f6d07f3dc714",
    "Audience": "86633ce1-c07f-4d13-86b0-5ad72cb2cd32"
  }
}
