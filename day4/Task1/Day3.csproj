<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude ALL files from test folders -->
    <Compile Remove="Tests\**" />
    <Compile Remove="IntegrationTests\**" />
    <Compile Remove="Quotes.Tests.Unit\**" />
    <Compile Remove="Quotes.Tests.Integration\**" />
    <!-- Exclude all nested Task subfolders (Day3/Task1, Task2, ...) -->
    <Compile Remove="Day1\**" />
    <Compile Remove="Day2\**" />
    <Compile Remove="Day3\**" />
    <Compile Remove="QuotesApi\**" />
    <Content Remove="Tests\**" />
    <Content Remove="IntegrationTests\**" />
    <Content Remove="Quotes.Tests.Unit\**" />
    <Content Remove="Quotes.Tests.Integration\**" />
    <Content Remove="Day1\**" />
    <Content Remove="Day2\**" />
    <Content Remove="Day3\**" />
    <Content Remove="QuotesApi\**" />
    <None Remove="Tests\**" />
    <None Remove="IntegrationTests\**" />
    <None Remove="Quotes.Tests.Unit\**" />
    <None Remove="Quotes.Tests.Integration\**" />
    <None Remove="Day1\**" />
    <None Remove="Day2\**" />
    <None Remove="Day3\**" />
    <None Remove="QuotesApi\**" />
    <EmbeddedResource Remove="Tests\**" />
    <EmbeddedResource Remove="IntegrationTests\**" />
    <EmbeddedResource Remove="Quotes.Tests.Unit\**" />
    <EmbeddedResource Remove="Quotes.Tests.Integration\**" />
    <EmbeddedResource Remove="Day1\**" />
    <EmbeddedResource Remove="Day2\**" />
    <EmbeddedResource Remove="Day3\**" />
    <EmbeddedResource Remove="QuotesApi\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>